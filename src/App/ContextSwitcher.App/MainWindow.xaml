<Window
    x:Class="ContextSwitcher.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:work="using:ContextSwitcher.Work">

    <Grid x:Name="Root" Padding="16" ColumnSpacing="16" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.4*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Context Switcher"
                   Style="{StaticResource TitleTextBlockStyle}" />

        <!-- Left: projects -->
        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
            <TextBlock Text="Projects" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{Binding Projects}"
                      SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      Height="240">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="work:Project">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Status}" Opacity="0.6" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Switch to selected" Command="{Binding SwitchCommand}" />
                <Button Content="Archive selected" Command="{Binding ArchiveCommand}" />
            </StackPanel>

            <TextBlock Text="Add a project" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <TextBox PlaceholderText="Name" Text="{Binding NewProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox PlaceholderText="Description (optional)" Text="{Binding NewProjectDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Add project" Command="{Binding AddProjectCommand}" />
        </StackPanel>

        <!-- Right: active project + session -->
        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
            <TextBlock Text="{Binding ActiveProjectText}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SessionStatusText}" TextWrapping="Wrap" Opacity="0.8" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox PlaceholderText="Objective (optional)" Width="240"
                         Text="{Binding SessionObjective, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Start session" Command="{Binding StartSessionCommand}" />
            </StackPanel>

            <TextBlock Text="Wrap up / end session" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Outcome:" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Outcomes}" SelectedItem="{Binding SelectedOutcome, Mode=TwoWay}" Width="220" />
            </StackPanel>
            <TextBox PlaceholderText="Completed work" Text="{Binding CompletedWork, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox PlaceholderText="Unfinished work" Text="{Binding UnfinishedWork, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox PlaceholderText="Blockers" Text="{Binding Blockers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox PlaceholderText="Notes for future you" Text="{Binding FutureSelfNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox PlaceholderText="Next action" Text="{Binding NextAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="End session" Command="{Binding EndSessionCommand}" />

            <TextBlock Text="Resume brief" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding ResumeBriefText}" TextWrapping="Wrap" Opacity="0.9" />

            <TextBlock Text="History" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <ListView ItemsSource="{Binding History}" Height="120"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
        </StackPanel>

        <!-- Bottom: status line -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
