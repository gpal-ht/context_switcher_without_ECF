<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinUI 3 GUI shell (ADR-0011). Unpackaged desktop app over the Work
       Engine services. Built with Visual Studio MSBuild (scripts/build-gui.ps1),
       not `dotnet build`, because WinUI PRI generation needs the VS MSIX tasks. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>ContextSwitcher.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <!-- Default is unpackaged so `scripts/build-gui.ps1` produces a directly
         runnable exe. `scripts/package-msix.ps1` passes BuildMsix=true, which
         leaves WindowsPackageType unset (packaged) to build the MSIX from the
         same project (ADR-0020). -->
    <WindowsPackageType Condition="'$(BuildMsix)' != 'true'">None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- WinUI XAML code generation can emit warnings we don't control; do not
         fail the GUI build on them (the pure-BCL projects keep warnings-as-errors). -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Work\ContextSwitcher.Work\ContextSwitcher.Work.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" />
  </ItemGroup>
</Project>
