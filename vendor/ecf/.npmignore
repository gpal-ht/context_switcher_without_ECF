# Release packages must contain only canonical content. npm uses this file
# instead of .gitignore when present, so it must list every dev/transient class.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.claude/
.vs/
.vscode/
runtime/
generated/
*.log
*.tmp
*.temp
# Dev scratch under scripts/ (mirrors .gitignore: scripts/*.txt).
scripts/*.txt
